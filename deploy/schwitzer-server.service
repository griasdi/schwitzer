[Unit]
Description=schwitzer server (@PUBLIC_HOST@, UDP @LISTEN@)

[Service]
Type=simple
# `deploy.sh` (run by the user, never by agents) installs this unit as a systemd
# user unit and replaces @BIN@, @DATA@, @LISTEN@ and @PUBLIC_HOST@.
# --auto-update replaces @BIN@ with each new release and execs it (same PID).
ExecStart=@BIN@ --listen @LISTEN@ --public-host @PUBLIC_HOST@ --data-dir @DATA@ --auto-update
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
